{
  "Delphi Class": {
    "prefix": "dclass",
    "description": "Delphi class with strict private, constructor and destructor",
    "body": [
      "type",
      "  T${1:ClassName} = class",
      "  strict private",
      "    F${2:Field}: ${3:string};",
      "  public",
      "    constructor Create(const A${2:Field}: ${3:string});",
      "    destructor Destroy; override;",
      "",
      "    property ${2:Field}: ${3:string} read F${2:Field};",
      "  end;",
      "",
      "{ T${1:ClassName} }",
      "",
      "constructor T${1:ClassName}.Create(const A${2:Field}: ${3:string});",
      "begin",
      "  inherited Create;",
      "  F${2:Field} := A${2:Field};",
      "end;",
      "",
      "destructor T${1:ClassName}.Destroy;",
      "begin",
      "  inherited;",
      "end;"
    ]
  },
  "Delphi Interface": {
    "prefix": "dintf",
    "description": "Delphi interface with GUID",
    "body": [
      "type",
      "  I${1:InterfaceName} = interface",
      "    ['{${2:GUID}}']",
      "    ${0}",
      "  end;"
    ]
  },
  "Delphi Service": {
    "prefix": "dservice",
    "description": "Service class implementing interface with constructor injection",
    "body": [
      "type",
      "  T${1:ServiceName} = class(TInterfacedObject, I${1:ServiceName})",
      "  strict private",
      "    F${2:Repository}: I${2:Repository};",
      "  public",
      "    constructor Create(const A${2:Repository}: I${2:Repository});",
      "    ${0}",
      "  end;",
      "",
      "{ T${1:ServiceName} }",
      "",
      "constructor T${1:ServiceName}.Create(const A${2:Repository}: I${2:Repository});",
      "begin",
      "  inherited Create;",
      "  F${2:Repository} := A${2:Repository};",
      "end;"
    ]
  },
  "Delphi Repository": {
    "prefix": "drepo",
    "description": "Repository class skeleton with connection injection",
    "body": [
      "type",
      "  T${1:EntityName}Repository = class(TInterfacedObject, I${1:EntityName}Repository)",
      "  strict private",
      "    FConnection: IConnection;",
      "  public",
      "    constructor Create(const AConnection: IConnection);",
      "",
      "    function FindById(const AId: Integer): T${1:EntityName};",
      "    function FindAll: TObjectList<T${1:EntityName}>;",
      "    procedure Save(const AEntity: T${1:EntityName});",
      "    procedure Delete(const AId: Integer);",
      "  end;",
      "",
      "{ T${1:EntityName}Repository }",
      "",
      "constructor T${1:EntityName}Repository.Create(const AConnection: IConnection);",
      "begin",
      "  inherited Create;",
      "  FConnection := AConnection;",
      "end;"
    ]
  },
  "Delphi Try Finally": {
    "prefix": "dtry",
    "description": "Try..finally block for resource management",
    "body": [
      "var",
      "  L${1:Object}: T${2:ClassName};",
      "begin",
      "  L${1:Object} := T${2:ClassName}.Create;",
      "  try",
      "    ${0}",
      "  finally",
      "    L${1:Object}.Free;",
      "  end;",
      "end;"
    ]
  },
  "Delphi Constant": {
    "prefix": "dconst",
    "description": "Constant with C_ prefix and UPPERCASE name",
    "body": [
      "const",
      "  C_${1:CONSTANT_NAME} = ${2:value};"
    ]
  },
  "Delphi Property": {
    "prefix": "dprop",
    "description": "Property with F field and setter with A parameter",
    "body": [
      "  strict private",
      "    F${1:PropName}: ${2:string};",
      "    procedure Set${1:PropName}(const AValue: ${2:string});",
      "  public",
      "    property ${1:PropName}: ${2:string} read F${1:PropName} write Set${1:PropName};",
      "",
      "procedure T${3:ClassName}.Set${1:PropName}(const AValue: ${2:string});",
      "begin",
      "  F${1:PropName} := AValue;",
      "end;"
    ]
  },
  "Delphi Method": {
    "prefix": "dmethod",
    "description": "Method with A-prefixed parameters and L-prefixed locals",
    "body": [
      "procedure T${1:ClassName}.${2:MethodName}(const A${3:Param}: ${4:string});",
      "var",
      "  L${5:Local}: ${6:string};",
      "begin",
      "  ${0}",
      "end;"
    ]
  },
  "Delphi Enumeration": {
    "prefix": "denum",
    "description": "Enumerated type with mnemonic prefix",
    "body": [
      "type",
      "  T${1:EnumName} = (",
      "    ${2:en}${3:First},",
      "    ${2:en}${4:Second},",
      "    ${2:en}${5:Third}",
      "  );"
    ]
  },
  "Delphi Unit": {
    "prefix": "dunit",
    "description": "Complete unit file skeleton with organized uses clause",
    "body": [
      "unit ${1:UnitName};",
      "",
      "interface",
      "",
      "uses",
      "  System.SysUtils,",
      "  System.Classes;",
      "",
      "type",
      "  T${2:ClassName} = class",
      "  strict private",
      "    ${0}",
      "  public",
      "    constructor Create;",
      "    destructor Destroy; override;",
      "  end;",
      "",
      "implementation",
      "",
      "{ T${2:ClassName} }",
      "",
      "constructor T${2:ClassName}.Create;",
      "begin",
      "  inherited;",
      "end;",
      "",
      "destructor T${2:ClassName}.Destroy;",
      "begin",
      "  inherited;",
      "end;",
      "",
      "end."
    ]
  },
  "Delphi Test Fixture": {
    "prefix": "dtest",
    "description": "DUnitX test fixture skeleton",
    "body": [
      "unit Test.${1:ClassName};",
      "",
      "interface",
      "",
      "uses",
      "  DUnitX.TestFramework,",
      "  ${2:UnitUnderTest};",
      "",
      "type",
      "  [TestFixture]",
      "  TTest${1:ClassName} = class",
      "  strict private",
      "    FSUT: T${1:ClassName};",
      "  public",
      "    [Setup]",
      "    procedure Setup;",
      "",
      "    [TearDown]",
      "    procedure TearDown;",
      "",
      "    [Test]",
      "    procedure Test${3:MethodName};",
      "  end;",
      "",
      "implementation",
      "",
      "{ TTest${1:ClassName} }",
      "",
      "procedure TTest${1:ClassName}.Setup;",
      "begin",
      "  FSUT := T${1:ClassName}.Create;",
      "end;",
      "",
      "procedure TTest${1:ClassName}.TearDown;",
      "begin",
      "  FSUT.Free;",
      "end;",
      "",
      "procedure TTest${1:ClassName}.Test${3:MethodName};",
      "begin",
      "  Assert.IsNotNull(FSUT);",
      "  ${0}",
      "end;",
      "",
      "initialization",
      "  TDUnitX.RegisterTestFixture(TTest${1:ClassName});",
      "",
      "end."
    ]
  },
  "Delphi Form": {
    "prefix": "dform",
    "description": "Form unit skeleton with proper structure",
    "body": [
      "unit ${1:FormUnit};",
      "",
      "interface",
      "",
      "uses",
      "  System.SysUtils,",
      "  System.Classes,",
      "  Vcl.Controls,",
      "  Vcl.Forms,",
      "  Vcl.Dialogs;",
      "",
      "type",
      "  T${2:FormName} = class(TForm)",
      "  strict private",
      "    { Private declarations }",
      "  public",
      "    { Public declarations }",
      "  end;",
      "",
      "var",
      "  ${2:FormName}: T${2:FormName};",
      "",
      "implementation",
      "",
      "{\\$R *.dfm}",
      "",
      "end."
    ]
  }
}
