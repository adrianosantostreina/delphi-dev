{
  "name": "delphi-dev-vscode",
  "displayName": "Delphi Dev",
  "description": "Remote control for the delphi-dev plugin: Delphi expert commands for Claude Code, Codex and OpenCode inside VS Code.",
  "version": "3.0.0",
  "publisher": "adrianosantos",
  "author": {
    "name": "Adriano Santos",
    "email": "adrianosantospro@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianosantostreina/delphi-dev.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "delphi",
    "object-pascal",
    "pascal",
    "claude",
    "claude-code",
    "codex",
    "opencode",
    "clean-code",
    "code-review",
    "firemonkey",
    "vcl",
    "firedac"
  ],
  "icon": "media/delphi-dev-icon.png",
  "activationEvents": [
    "workspaceContains:**/*.dpr",
    "workspaceContains:**/*.pas",
    "workspaceContains:**/*.dfm",
    "onLanguage:pascal",
    "onLanguage:objectpascal"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "delphi-dev.audit",
        "title": "Delphi Dev: Audit project",
        "icon": "$(checklist)"
      },
      {
        "command": "delphi-dev.review",
        "title": "Delphi Dev: Review code",
        "icon": "$(eye)"
      },
      {
        "command": "delphi-dev.write",
        "title": "Delphi Dev: Write code",
        "icon": "$(edit)"
      },
      {
        "command": "delphi-dev.spec",
        "title": "Delphi Dev: Generate SPEC",
        "icon": "$(file-text)"
      },
      {
        "command": "delphi-dev.tdd",
        "title": "Delphi Dev: Generate tests (TDD)",
        "icon": "$(beaker)"
      },
      {
        "command": "delphi-dev.newProject",
        "title": "Delphi Dev: New project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "delphi-dev.e2e",
        "title": "Delphi Dev: E2E test",
        "icon": "$(play)"
      },
      {
        "command": "delphi-dev.dashboard",
        "title": "Delphi Dev: Repository dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "delphi-dev.update",
        "title": "Delphi Dev: Update knowledge base",
        "icon": "$(sync)"
      },
      {
        "command": "delphi-dev.contributeKb",
        "title": "Delphi Dev: Contribute knowledge",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "delphi-dev.about",
        "title": "Delphi Dev: About the plugin",
        "icon": "$(info)"
      },
      {
        "command": "delphi-dev.createClaudeignore",
        "title": "Delphi Dev: Create .claudeignore",
        "icon": "$(file-add)"
      },
      {
        "command": "delphi-dev.chooseAgent",
        "title": "Delphi Dev: Choose Agent",
        "icon": "$(account)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "delphiDev",
          "title": "Delphi Dev",
          "icon": "media/delphi-dev-icon.svg"
        }
      ]
    },
    "views": {
      "delphiDev": [
        {
          "id": "delphiDevCommands",
          "name": "Commands",
          "contextualTitle": "Delphi Dev"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "delphiDevCommands",
        "contents": "No Delphi project detected.\n\nOpen a folder containing .dpr or .pas files to get started.\n\n[Create New Project](command:delphi-dev.newProject)",
        "when": "!delphi-dev.isDelphiProject"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "delphi-dev.review",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@1"
        },
        {
          "command": "delphi-dev.audit",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@2"
        },
        {
          "command": "delphi-dev.write",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@3"
        },
        {
          "command": "delphi-dev.tdd",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@4"
        },
        {
          "command": "delphi-dev.spec",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@5"
        }
      ],
      "explorer/context": [
        {
          "command": "delphi-dev.review",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@1"
        },
        {
          "command": "delphi-dev.audit",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@2"
        },
        {
          "command": "delphi-dev.tdd",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@3"
        }
      ]
    },
    "snippets": [
      {
        "language": "pascal",
        "path": "./snippets/delphi.json"
      },
      {
        "language": "objectpascal",
        "path": "./snippets/delphi.json"
      }
    ],
    "configuration": {
      "title": "Delphi Dev",
      "properties": {
        "delphiDev.autoCreateClaudeignore": {
          "type": "boolean",
          "default": true,
          "description": "Automatically offer to create .claudeignore when a Delphi project is detected."
        },
        "delphiDev.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Delphi Dev status bar item when Delphi files are detected."
        },
        "delphiDev.language": {
          "type": "string",
          "enum": [
            "pt-BR",
            "en"
          ],
          "default": "pt-BR",
          "description": "Reserved: language for Delphi Dev prompts (not used yet)."
        },
        "delphiDev.agent": {
          "type": "string",
          "enum": [
            "auto",
            "claude",
            "codex",
            "opencode"
          ],
          "enumDescriptions": [
            "Use the only installed agent, or the last one you used",
            "Claude Code",
            "Codex",
            "OpenCode"
          ],
          "default": "auto",
          "description": "Which AI agent receives the Delphi Dev commands."
        },
        "delphiDev.opencodePort": {
          "type": "number",
          "default": 4096,
          "scope": "machine",
          "description": "Port used to control OpenCode (opencode --port). A server already listening there is reused. Machine-scoped: a repository .vscode/settings.json cannot change it."
        },
        "delphiDev.codexPromptUri": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Experimental: try to prefill the Codex composer through vscode://openai.chatgpt/?prompt=. Off = open the panel and copy the command. Machine-scoped: a repository .vscode/settings.json cannot change it."
        }
      }
    },
    "configurationDefaults": {
      "[pascal]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.rulers": [
          120
        ],
        "editor.wordWrap": "off"
      },
      "[objectpascal]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.rulers": [
          120
        ],
        "editor.wordWrap": "off"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "test": "vitest run",
    "sync": "node scripts/sync-registry.mjs --write",
    "check:registry": "node scripts/sync-registry.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
