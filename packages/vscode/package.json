{
  "name": "delphi-dev-vscode",
  "displayName": "Delphi Dev for Claude Code",
  "description": "VS Code integration for the delphi-dev Claude Code plugin. Senior Delphi expert with code review, audit, TDD, and coding standards enforcement.",
  "version": "2.0.0",
  "publisher": "adrianosantos",
  "author": {
    "name": "Adriano Santos",
    "email": "adrianosantospro@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdrianosantosTreina/delphi-dev-vscode"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "delphi",
    "object-pascal",
    "pascal",
    "claude",
    "claude-code",
    "clean-code",
    "code-review",
    "firemonkey",
    "vcl",
    "firedac"
  ],
  "icon": "media/delphi-dev-icon.png",
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "activationEvents": [
    "workspaceContains:**/*.dpr",
    "workspaceContains:**/*.pas",
    "workspaceContains:**/*.dfm",
    "onLanguage:pascal",
    "onLanguage:objectpascal"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "delphi-dev.write",
        "title": "Delphi Dev: Write Code",
        "icon": "$(edit)"
      },
      {
        "command": "delphi-dev.audit",
        "title": "Delphi Dev: Audit Project",
        "icon": "$(checklist)"
      },
      {
        "command": "delphi-dev.review",
        "title": "Delphi Dev: Review Code",
        "icon": "$(eye)"
      },
      {
        "command": "delphi-dev.spec",
        "title": "Delphi Dev: Generate Spec",
        "icon": "$(file-text)"
      },
      {
        "command": "delphi-dev.tdd",
        "title": "Delphi Dev: Generate Tests (TDD)",
        "icon": "$(beaker)"
      },
      {
        "command": "delphi-dev.newProject",
        "title": "Delphi Dev: New Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "delphi-dev.about",
        "title": "Delphi Dev: About",
        "icon": "$(info)"
      },
      {
        "command": "delphi-dev.createClaudeignore",
        "title": "Delphi Dev: Create .claudeignore",
        "icon": "$(file-add)"
      },
      {
        "command": "delphi-dev.build",
        "title": "Delphi Dev: Build Project",
        "icon": "$(play)"
      },
      {
        "command": "delphi-dev.refactor",
        "title": "Delphi Dev: Refactor Code",
        "icon": "$(wand)"
      },
      {
        "command": "delphi-dev.migrate",
        "title": "Delphi Dev: Migrate Legacy Code",
        "icon": "$(arrow-right)"
      },
      {
        "command": "delphi-dev.contributeKb",
        "title": "Delphi Dev: Contribute to Knowledge Base",
        "icon": "$(cloud-upload)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "delphiDev",
          "title": "Delphi Dev",
          "icon": "media/delphi-dev-icon.svg"
        }
      ]
    },
    "views": {
      "delphiDev": [
        {
          "id": "delphiDevCommands",
          "name": "Commands",
          "contextualTitle": "Delphi Dev"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "delphiDevCommands",
        "contents": "No Delphi project detected.\n\nOpen a folder containing .dpr or .pas files to get started.\n\n[Create New Project](command:delphi-dev.newProject)",
        "when": "!delphi-dev.isDelphiProject"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "delphi-dev.review",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@1"
        },
        {
          "command": "delphi-dev.audit",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@2"
        },
        {
          "command": "delphi-dev.write",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@3"
        },
        {
          "command": "delphi-dev.tdd",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@4"
        },
        {
          "command": "delphi-dev.spec",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@5"
        }
      ],
      "explorer/context": [
        {
          "command": "delphi-dev.review",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@1"
        },
        {
          "command": "delphi-dev.audit",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@2"
        },
        {
          "command": "delphi-dev.tdd",
          "when": "resourceExtname =~ /\\.(pas|dpr|dfm|dpk|inc|fmx)$/",
          "group": "delphiDev@3"
        }
      ]
    },
    "snippets": [
      {
        "language": "pascal",
        "path": "./snippets/delphi.json"
      },
      {
        "language": "objectpascal",
        "path": "./snippets/delphi.json"
      }
    ],
    "configuration": {
      "title": "Delphi Dev",
      "properties": {
        "delphiDev.autoCreateClaudeignore": {
          "type": "boolean",
          "default": true,
          "description": "Automatically offer to create .claudeignore when a Delphi project is detected."
        },
        "delphiDev.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Delphi Dev status bar item when Delphi files are detected."
        },
        "delphiDev.language": {
          "type": "string",
          "enum": [
            "pt-BR",
            "en"
          ],
          "default": "pt-BR",
          "description": "Language for Delphi Dev prompts sent to Claude Code."
        }
      }
    },
    "configurationDefaults": {
      "[pascal]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.rulers": [120],
        "editor.wordWrap": "off"
      },
      "[objectpascal]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.rulers": [120],
        "editor.wordWrap": "off"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  }
}
