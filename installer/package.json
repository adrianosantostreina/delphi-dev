{
  "name": "delphi-dev",
  "version": "2.0.4",
  "description": "Delphi expert plugin for Claude Code — installs in one command",
  "bin": {
    "delphi-dev": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "delphi",
    "claude-code",
    "plugin",
    "rad-studio",
    "firemonkey"
  ],
  "author": "Adriano Santos <adrianosantospro@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianosantostreina/delphi-dev.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
